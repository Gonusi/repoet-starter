<!doctype html>
<html lang="{{ blog.language or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#22251f" media="(prefers-color-scheme: dark)">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {#- What the page is called and how it is described, in the tab, in search
      results and on a share card. A post is its title; an untitled note is
      its opening words, never the blog's name. Any other page is its own
      name and the blog's ("Page 2 · Blog", "Tagged go · Blog"); home is the
      blog's name. A post without a description is described by its own
      first sentence, never the blog's tagline; no description at all writes
      none. -#}
  {%- set isPost = ogType == 'article' %}
  {%- if isPost %}
  {%- set item = collections.everyPost | itemAt(page.inputPath) %}
  {%- set words = (item.content if item else content) | plainText %}
  {%- set pageTitle = title or (words | noteTitle) or blog.title %}
  {%- set pageDescription = description or (words | firstSentence) %}
  {%- else %}
  {%- set pageTitle = (title + (' · ' + blog.title if blog.title else '')) if title else blog.title %}
  {%- set pageDescription = description or blog.description %}
  {%- endif %}
  <title>{{ pageTitle }}</title>
  {%- if pageDescription %}
  <meta name="description" content="{{ pageDescription }}">
  {%- endif %}
  {%- if blog.author %}
  <meta name="author" content="{{ blog.author }}">
  {%- endif %}
  {%- if site.url %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- endif %}
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  {#- The two faces every page uses (the blog's name is the italic) load
      first, so the name does not visibly change font as the page opens. #}
  <link rel="preload" href="{{ '/fonts/Literata-400-italic.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/fonts/Literata-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="alternate" type="application/atom+xml" title="{{ blog.title }}" href="{{ '/feed.xml' | url }}">
  {#- How this page unfurls when shared (Slack, iMessage, X, LinkedIn).
      Posts set ogType: article; everything else is a website. The share image
      is the post's first image unless frontmatter `image:` or blog.json
      `socialImage` (a root path like "/assets/social.png") says otherwise —
      and when there is no image, no og:image: a text-only preview is honest,
      a broken image URL is not. -#}
  {#- A menu tag's only post, kept off the home page, is a page, not an article. -#}
  {%- set asPage = menuPages and menuPages[page.inputPath] -%}
  <meta property="og:type" content="{{ 'website' if asPage else (ogType or 'website') }}">
  <meta property="og:title" content="{{ pageTitle }}">
  {%- if pageDescription %}
  <meta property="og:description" content="{{ pageDescription }}">
  {%- endif %}
  <meta property="og:site_name" content="{{ blog.title }}">
  {%- if site.url %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {%- endif %}
  {%- if ogType == 'article' and date and not asPage %}
  <meta property="article:published_time" content="{{ date | isoDate }}">
  {%- endif %}
  {%- if ogType == 'article' and updated and not asPage %}
  <meta property="article:modified_time" content="{{ updated | isoDate }}">
  {%- endif %}
  {%- set shareImage = (image or (content | firstImage) or blog.socialImage) | absUrl(page.url) %}
  {%- set shareImageAlt = imageAlt or (content | firstImageAlt) %}
  {%- if shareImage %}
  <meta property="og:image" content="{{ shareImage }}">
  {%- if shareImageAlt %}
  <meta property="og:image:alt" content="{{ shareImageAlt }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  {%- else %}
  <meta name="twitter:card" content="summary">
  {%- endif %}
  {# Theme adapted from no-style-please (MIT) — see NOTICE. Modest on purpose,
     and matched to Repoet's own design language: two voices (Literata for the
     words, IBM Plex Mono for the machinery), paper/ink/green. Yours to edit. #}
  <style>
    /* The fonts, self-hosted: the blog makes no third-party requests. Literata
       is one variable font per style, so its every weight is real (the
       wordmark's italic 600 was a smeared fake); Plex Mono has the italic of
       code comments and the 600 of code in a heading. Nothing is faked:
       font-synthesis is off. Each face has a Latin file and a Latin Extended
       one (ą, č, ş, ő…); a page loads the second only when it uses those
       letters. */
    @font-face { font-family: 'Literata'; src: url('{{ '/fonts/Literata-400-normal.woff2' | url }}') format('woff2'); font-weight: 400 900; font-style: normal; font-display: swap;
                 unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'Literata'; src: url('{{ '/fonts/Literata-400-normal-latin-ext.woff2' | url }}') format('woff2'); font-weight: 400 900; font-style: normal; font-display: swap;
                 unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
    @font-face { font-family: 'Literata'; src: url('{{ '/fonts/Literata-400-italic.woff2' | url }}') format('woff2'); font-weight: 400 900; font-style: italic; font-display: swap;
                 unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'Literata'; src: url('{{ '/fonts/Literata-400-italic-latin-ext.woff2' | url }}') format('woff2'); font-weight: 400 900; font-style: italic; font-display: swap;
                 unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
    @font-face { font-family: 'IBM Plex Mono'; src: url('{{ '/fonts/IBMPlexMono-400-normal.woff2' | url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap;
                 unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'IBM Plex Mono'; src: url('{{ '/fonts/IBMPlexMono-400-normal-latin-ext.woff2' | url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap;
                 unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
    @font-face { font-family: 'IBM Plex Mono'; src: url('{{ '/fonts/IBMPlexMono-400-italic.woff2' | url }}') format('woff2'); font-weight: 400; font-style: italic; font-display: swap;
                 unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'IBM Plex Mono'; src: url('{{ '/fonts/IBMPlexMono-400-italic-latin-ext.woff2' | url }}') format('woff2'); font-weight: 400; font-style: italic; font-display: swap;
                 unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
    @font-face { font-family: 'IBM Plex Mono'; src: url('{{ '/fonts/IBMPlexMono-600-normal.woff2' | url }}') format('woff2'); font-weight: 600 700; font-style: normal; font-display: swap;
                 unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    @font-face { font-family: 'IBM Plex Mono'; src: url('{{ '/fonts/IBMPlexMono-600-normal-latin-ext.woff2' | url }}') format('woff2'); font-weight: 600 700; font-style: normal; font-display: swap;
                 unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
    :root {
      --paper: #f5f4f0; --ink: #22251f; --ink-soft: #6d7167; --rule: #e6e4dc;
      --green: #2e6e4e; --green-deep: #245a40;
      --serif: 'Literata', Georgia, serif;
      --mono: 'IBM Plex Mono', ui-monospace, monospace;
      color-scheme: light dark;
    }
    body { max-width: 40rem; margin: 0 auto; padding: 1.6rem 1.2rem 4rem;
           font-family: var(--serif); font-size: 17px; line-height: 1.62;
           color: var(--ink); background: var(--paper); font-synthesis: none; }
    header { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap;
             padding-bottom: 0.9rem; border-bottom: 1px solid var(--rule); margin-bottom: 2rem; }
    .tagline { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-soft); }
    /* The blog's name. On the home list it is the page's heading (h1), and
       looks the same. */
    .wordmark { margin: 0; font-size: 21px; line-height: 1.3; min-width: 0; overflow-wrap: anywhere; }
    .wordmark, .wordmark a { font-family: var(--serif); font-style: italic; font-weight: 600;
                             color: var(--ink); text-decoration: none; }
    main h1 { font-size: clamp(1.6rem, 6vw, 2rem); }
    h1, h2, h3 { font-weight: 600; line-height: 1.25; }
    main { overflow-wrap: anywhere; }
    a { color: var(--green-deep); text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .meta { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-soft); }
    .meta time, .meta .by { white-space: nowrap; }
    ul.posts { list-style: none; padding: 0; margin-top: 0; }
    ul.posts li { margin: 0; padding: 1.05rem 0; border-bottom: 1px solid var(--rule); }
    ul.posts a { color: inherit; text-decoration: none; }
    ul, ol { padding-left: 1.4em; }
    /* Images and frames stay in the column; a tall photo stays within the
       screen, its shape kept (sizes are set when the site is built). */
    img, video { max-width: 100%; height: auto; }
    img { border-radius: 8px; }
    img:not([width]):not([height]) { max-height: 80vh; }
    iframe, embed, object { max-width: 100%; }
    figure { margin: 1.6em 0; text-align: center; }
    figure img { vertical-align: top; }
    figcaption { margin-top: 0.4rem; font-family: var(--mono); font-size: 0.72rem; color: var(--ink-soft); }
    .figures { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin: 1.6em 0; }
    .figures figure { margin: 0; max-width: 100%; }
    /* Code: one ground for a block and a word of code. A block keeps its
       lines (it scrolls sideways) and shades its right edge while more is
       hidden there. */
    code { font-family: var(--mono); font-size: 0.85em; color: var(--ink); background: var(--code-ground); padding: 1px 5px; border-radius: 4px; }
    a code { color: inherit; }
    pre { font-family: var(--mono); font-size: 0.85em; line-height: 1.5; padding: 1rem; overflow-x: auto; border-radius: 8px;
          background:
            linear-gradient(to left, var(--code-ground) 40%, transparent) right / 2.5rem 100% no-repeat local,
            linear-gradient(to left, var(--code-edge), transparent) right / 1rem 100% no-repeat scroll,
            var(--code-ground); }
    pre code { font-size: inherit; background: none; padding: 0; }
    blockquote { border-left: 2px solid var(--rule); margin-left: 0; padding-left: 1rem; color: var(--ink-soft); font-style: italic; }
    hr { border: none; border-top: 1px solid var(--rule); }
    /* Tables: a rule under the header row and between rows; a wide one
       scrolls inside the column. */
    .table { overflow-x: auto; margin: 1.4em 0; }
    table { border-collapse: collapse; font-size: 0.94em; overflow-wrap: normal; }
    th, td { padding: 0.4em 0.9em 0.4em 0; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
    th { font-weight: 600; border-bottom-color: var(--ink-soft); }
    .empty { font-family: var(--mono); font-size: 0.8rem; color: var(--ink-soft); }
    /* Small links in the system voice (tags, the footer, "‹ All posts",
       pages) are at least 24px to tap (WCAG 2.2 AA). */
    .meta a, .back a, body > footer a, nav.pages a, ul.tags a { display: inline-block; min-height: 24px; min-width: 24px; line-height: 24px; }
    .back { font-family: var(--mono); font-size: 0.72rem; }
    nav.pages { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
                margin-top: 1.6rem; font-family: var(--mono); font-size: 0.72rem; color: var(--ink-soft); }
    nav.pages .older { margin-left: auto; }
    ul.tags { list-style: none; padding: 0; margin-top: 0; font-family: var(--mono); font-size: 0.8rem; }
    ul.tags li { padding: 0.25rem 0; }
    ul.tags .meta { margin-left: 0.4rem; }
    /* The menu (blog.json "menu"): beside the title on a wide screen while it
       fits, right-aligned; otherwise under it, starting at the title's left
       edge, wrapping to a second line when it must. On a phone it is always
       under the title. Plain links, no script. (space-between puts a lone
       item on a line at its start.) With a menu, the tagline has a line of
       its own under them on a wide screen, so the menu stays by the title. */
    header.with-menu { justify-content: space-between; }
    header.with-menu .tagline { order: 3; flex-basis: 100%; }
    header nav { display: flex; flex-wrap: wrap; gap: 0 1.2rem; }
    header nav a { font-family: var(--mono); font-style: normal; font-weight: 400; font-size: 0.8rem;
                   padding: 0.3rem 0; color: var(--ink); text-decoration: none; }
    @media (max-width: 40rem) {
      header.with-menu nav { flex-basis: 100%; }
      header.with-menu .tagline { order: 0; }
      /* 44px to tap. */
      header nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0; }
      .wordmark { font-size: 19px; }
    }
    /* The open page's menu link, and on a post the link of the menu's list
       it belongs to, are underlined in the green. */
    header nav a[aria-current] { text-decoration: underline; text-decoration-thickness: 1px;
                                 text-underline-offset: 4px; text-decoration-color: var(--green); }
    /* Code colours, given when the site is built: no script reaches readers.
       Calm on purpose: comments recede, keywords take the green, strings and
       numbers a warm ink; everything else stays ink. Each is at least 4.5:1
       on the code block's ground, #ecebe5 (WCAG AA). */
    :root { --code-ground: #ecebe5; --code-edge: rgba(34, 37, 31, 0.14);
            --code-comment: #646860; --code-keyword: #245a40; --code-string: #7c4f1d; --code-number: #8f3527; }
    .token.comment, .token.prolog, .token.doctype, .token.cdata { color: var(--code-comment); font-style: italic; }
    .token.keyword, .token.atrule, .token.important, .token.tag, .token.selector, .token.builtin,
    .token.rule, .token.inserted { color: var(--code-keyword); }
    .token.string, .token.char, .token.attr-value, .token.regex, .token.template-string, .token.url { color: var(--code-string); }
    .token.number, .token.boolean, .token.constant, .token.symbol, .token.entity, .token.deleted { color: var(--code-number); }
    .token.tag .token.punctuation, .token.attr-value .token.punctuation { color: inherit; }
    /* The footer (blog.json "footer"): one quiet line under every page, in
       the grey of dates. Its links are the blog's links, quieter: grey words
       over the green underline. ink-soft is 4.5:1 on the paper (WCAG AA). */
    body > footer { margin-top: 3rem; font-family: var(--mono); font-size: 0.72rem; color: var(--ink-soft); }
    body > footer a { color: inherit; text-decoration-color: var(--green); }
    /* Hover colours only where there is a pointer: on a phone a tapped link
       kept them. */
    @media (hover: hover) {
      a:hover { color: var(--green); }
      .wordmark a:hover, header nav a:hover, ul.posts a:hover, body > footer a:hover { color: var(--green-deep); }
    }
    :focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
    /* Dark, when the reader's system is: the same tokens, with ink as the
       ground and the app's green-on-ink for links. Every pair of words and
       ground is at least 4.5:1 (WCAG AA), code colours included. */
    @media screen and (prefers-color-scheme: dark) {
      :root {
        --paper: #22251f; --ink: #e6e4dc; --ink-soft: #9a9e93; --rule: #3a3d35;
        --green: #c2e6d3; --green-deep: #9fd3b8;
        --code-ground: #2c2f28; --code-edge: rgba(0, 0, 0, 0.4);
        --code-comment: #a3a69c; --code-keyword: #9fd3b8; --code-string: #ddb88c; --code-number: #efa08e;
      }
    }
    /* On paper: the words, the code wrapped instead of cut off, a link's
       address after it; no menu, footer or ways back. */
    @media print {
      body { max-width: none; padding: 0; background: #fff; color: #000; font-size: 11pt; }
      header nav, body > footer, nav.pages, .back { display: none; }
      header { border-bottom-color: #bbb; }
      pre { white-space: pre-wrap; overflow-wrap: anywhere; background: none; border: 1px solid #bbb; }
      .table { overflow: visible; }
      a { color: inherit; }
      article a[href^="http"]::after { content: " (" attr(href) ")"; font-family: var(--mono); font-size: 0.8em; color: #444; }
      pre, figure, img, table, blockquote { break-inside: avoid; }
      h1, h2, h3 { break-after: avoid; }
    }
  </style>
</head>
<body>
  {%- set menuLinks = collections.menu if (collections.menu and collections.menu.length) else [] %}
  {#- The menu's list a post belongs to, or a tag page shows, is marked too
      (aria-current="true": the reader is in it, not on it). -#}
  {%- if isPost and not asPage %}{% set here = tags | sectionOf %}
  {%- elif tag and tag.slug %}{% set here = [tag.slug] | sectionOf %}
  {%- else %}{% set here = null %}{% endif %}
  <header{% if menuLinks.length %} class="with-menu"{% endif %}>
    {%- if homeList %}
    <h1 class="wordmark"><a href="{{ '/' | url }}">{{ blog.title }}</a></h1>
    {%- else %}
    <a class="wordmark" href="{{ '/' | url }}">{{ blog.title }}</a>
    {%- endif %}
    {%- if blog.showDescription and blog.description %}
    <span class="tagline">{{ blog.description }}</span>
    {%- endif %}
    {%- if menuLinks.length %}
    <nav aria-label="Menu">
      {%- for link in menuLinks %}
      <a href="{{ link.url | url }}"{% if link.url == page.url %} aria-current="page"{% elif here and link.url == here.url %} aria-current="true"{% endif %}>{{ link.label }}</a>
      {%- endfor %}
    </nav>
    {%- endif %}
  </header>
  <main>{{ content | safe }}</main>
  {%- if footerHtml %}
  <footer>{{ footerHtml | safe }}</footer>
  {%- endif %}
</body>
</html>
