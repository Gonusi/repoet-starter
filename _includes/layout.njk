<!doctype html>
<html lang="{{ blog.language or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f4f0">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <title>{{ title or blog.title }}</title>
  <meta name="description" content="{{ description or blog.description }}">
  {%- if blog.author %}
  <meta name="author" content="{{ blog.author }}">
  {%- endif %}
  {%- if site.url %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- endif %}
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="{{ blog.title }}" href="{{ '/feed.xml' | url }}">
  {#- How this page unfurls when shared (Slack, iMessage, X, LinkedIn).
      Posts set ogType: article; everything else is a website. The share image
      is the post's first image unless frontmatter `image:` or blog.json
      `socialImage` (a root path like "/assets/social.png") says otherwise —
      and when there is no image, no og:image: a text-only preview is honest,
      a broken image URL is not. -#}
  {#- A menu tag's only post, kept off the home page, is a page, not an article. -#}
  {%- set asPage = menuPages and menuPages[page.inputPath] -%}
  <meta property="og:type" content="{{ 'website' if asPage else (ogType or 'website') }}">
  <meta property="og:title" content="{{ title or blog.title }}">
  <meta property="og:description" content="{{ description or blog.description }}">
  <meta property="og:site_name" content="{{ blog.title }}">
  {%- if site.url %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {%- endif %}
  {%- if ogType == 'article' and date and not asPage %}
  <meta property="article:published_time" content="{{ date | isoDate }}">
  {%- endif %}
  {%- if ogType == 'article' and updated and not asPage %}
  <meta property="article:modified_time" content="{{ updated | isoDate }}">
  {%- endif %}
  {%- set shareImage = (image or (content | firstImage) or blog.socialImage) | absUrl(page.url) %}
  {%- set shareImageAlt = imageAlt or (content | firstImageAlt) %}
  {%- if shareImage %}
  <meta property="og:image" content="{{ shareImage }}">
  {%- if shareImageAlt %}
  <meta property="og:image:alt" content="{{ shareImageAlt }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  {%- else %}
  <meta name="twitter:card" content="summary">
  {%- endif %}
  {# Theme adapted from no-style-please (MIT) — see NOTICE. Modest on purpose,
     and matched to Repoet's own design language: two voices (Literata for the
     words, IBM Plex Mono for the machinery), paper/ink/green. Yours to edit. #}
  <style>
    @font-face { font-family: 'Literata'; src: url('{{ '/fonts/Literata-400-normal.woff2' | url }}') format('woff2'); font-weight: 400; font-display: swap; }
    @font-face { font-family: 'Literata'; src: url('{{ '/fonts/Literata-400-italic.woff2' | url }}') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
    @font-face { font-family: 'Literata'; src: url('{{ '/fonts/Literata-600-normal.woff2' | url }}') format('woff2'); font-weight: 600; font-display: swap; }
    @font-face { font-family: 'IBM Plex Mono'; src: url('{{ '/fonts/IBMPlexMono-400-normal.woff2' | url }}') format('woff2'); font-weight: 400; font-display: swap; }
    :root {
      --paper: #f5f4f0; --ink: #22251f; --ink-soft: #6e7268; --rule: #e6e4dc;
      --green: #2e6e4e; --green-deep: #245a40; --green-tint: #eaf1ec;
      --serif: 'Literata', Georgia, serif;
      --mono: 'IBM Plex Mono', ui-monospace, monospace;
    }
    body { max-width: 40rem; margin: 0 auto; padding: 1.6rem 1.2rem 4rem;
           font-family: var(--serif); font-size: 17px; line-height: 1.62;
           color: var(--ink); background: var(--paper); }
    header { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap;
             padding-bottom: 0.9rem; border-bottom: 1px solid var(--rule); margin-bottom: 2rem; }
    .tagline { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-soft); }
    header a { font-family: var(--serif); font-style: italic; font-weight: 600;
               font-size: 21px; color: var(--ink); text-decoration: none; }
    header a:hover { color: var(--green-deep); }
    h1, h2, h3 { font-weight: 600; line-height: 1.25; }
    a { color: var(--green-deep); text-decoration-thickness: 1px; text-underline-offset: 3px; }
    a:hover { color: var(--green); }
    .meta { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-soft); }
    ul.posts { list-style: none; padding: 0; }
    ul.posts li { margin: 0; padding: 1.05rem 0; border-bottom: 1px solid var(--rule); }
    ul.posts a { color: inherit; text-decoration: none; }
    ul.posts a:hover { color: var(--green-deep); }
    img { max-width: 100%; border-radius: 8px; }
    code { font-family: var(--mono); font-size: 0.85em; background: var(--green-tint); padding: 1px 5px; border-radius: 4px; }
    pre { background: #ecebe5; padding: 1rem; overflow-x: auto; border-radius: 8px; }
    pre code { background: none; padding: 0; }
    blockquote { border-left: 2px solid var(--rule); margin-left: 0; padding-left: 1rem; color: var(--ink-soft); font-style: italic; }
    hr { border: none; border-top: 1px solid var(--rule); }
    .empty { font-family: var(--mono); font-size: 0.8rem; color: var(--ink-soft); }
    /* The menu (blog.json "menu"): beside the title, under it on a phone. */
    header nav { display: flex; flex-wrap: wrap; gap: 0 1.1rem; margin-left: auto; }
    header nav a { font-family: var(--mono); font-style: normal; font-weight: 400; font-size: 0.8rem;
                   padding: 0.3rem 0; color: var(--ink); }
    header nav a:hover { color: var(--green-deep); }
    header nav a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 1px;
                                        text-underline-offset: 4px; text-decoration-color: var(--green); }
    /* Code colours, given when the site is built: no script reaches readers.
       Calm on purpose: comments recede, keywords take the green, strings and
       numbers a warm ink; everything else stays ink. Each is at least 4.5:1
       on the code block's ground, #ecebe5 (WCAG AA). */
    :root { --code-comment: #646860; --code-keyword: #245a40; --code-string: #7c4f1d; --code-number: #8f3527; }
    .token.comment, .token.prolog, .token.doctype, .token.cdata { color: var(--code-comment); font-style: italic; }
    .token.keyword, .token.atrule, .token.important, .token.tag, .token.selector, .token.builtin,
    .token.rule, .token.inserted { color: var(--code-keyword); }
    .token.string, .token.char, .token.attr-value, .token.regex, .token.template-string, .token.url { color: var(--code-string); }
    .token.number, .token.boolean, .token.constant, .token.symbol, .token.entity, .token.deleted { color: var(--code-number); }
    .token.tag .token.punctuation, .token.attr-value .token.punctuation { color: inherit; }
    :focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  </style>
</head>
<body>
  <header>
    <a href="{{ '/' | url }}">{{ blog.title }}</a>
    {%- if blog.showDescription and blog.description %}
    <span class="tagline">{{ blog.description }}</span>
    {%- endif %}
    {%- if collections.menu and collections.menu.length %}
    <nav aria-label="Menu">
      {%- for link in collections.menu %}
      <a href="{{ link.url | url }}"{% if link.url == page.url %} aria-current="page"{% endif %}>{{ link.label }}</a>
      {%- endfor %}
    </nav>
    {%- endif %}
  </header>
  <main>{{ content | safe }}</main>
</body>
</html>
