<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or blog.title }}</title>
  {# Theme adapted from no-style-please (MIT) — see NOTICE. Modest on purpose. #}
  <style>
    body { max-width: 40rem; margin: 2rem auto; padding: 0 1rem;
           font-family: Georgia, serif; line-height: 1.6; color: #22251f; background: #fffefc; }
    header, footer { font-family: ui-monospace, monospace; font-size: 0.8rem; }
    header a, footer a { color: #2e6e4e; text-decoration: none; }
    h1, h2, h3 { line-height: 1.25; }
    .meta { font-family: ui-monospace, monospace; font-size: 0.75rem; color: #6e7268; }
    ul.posts { list-style: none; padding: 0; }
    ul.posts li { margin-bottom: 1.4rem; }
    ul.posts a { color: inherit; text-decoration: none; }
    ul.posts a:hover { color: #2e6e4e; }
    img { max-width: 100%; }
    code { font-family: ui-monospace, monospace; font-size: 0.9em; background: #eaf1ec; padding: 0 4px; border-radius: 4px; }
    pre { background: #f3f2ed; padding: 1rem; overflow-x: auto; }
    pre code { background: none; padding: 0; }
  </style>
</head>
<body>
  <header><a href="{{ '/' | url }}">{{ blog.title }}</a></header>
  <main>{{ content | safe }}</main>
</body>
</html>
